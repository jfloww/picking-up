DJANGO_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Picking Up

# Same Google OAuth Client ID as backend/.env's GOOGLE_OAUTH_CLIENT_ID — this
# one is intentionally public (NEXT_PUBLIC_*), since the GIS button runs in
# the browser. Google enforces the actual security boundary by restricting
# "Authorized JavaScript origins" for this client ID in Cloud Console.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Production (Vercel) ---
# Set in the Vercel project's environment variables, not here. Must be
# https:// and point at the OCI VM's public domain — the auth cookies are
# marked `secure` in production (see lib/auth/cookies.ts) and won't be sent
# over plain HTTP.
# DJANGO_API_BASE_URL=https://<oci-vm-public-domain>
