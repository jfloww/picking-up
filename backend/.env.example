DJANGO_SECRET_KEY=replace-this-in-local-env
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Use sqlite locally by default. Set DATABASE_URL for PostgreSQL.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME

# Oracle Autonomous Database (OCI). When all three are set, Django uses Oracle
# instead of sqlite/DATABASE_URL. DSN is the full (description=...) connect
# string from the OCI console. See docs/planning/6. oracle-database.md.
# ORACLE_DB_USER=
# ORACLE_DB_PASSWORD=
# ORACLE_DB_DSN=

# --- Production (OCI Always Free VM) ---
# DJANGO_DEBUG must be False. A real DJANGO_SECRET_KEY is required or Django
# refuses to start (see config/settings.py). Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# DJANGO_SECRET_KEY=<generated-secret>
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=<oci-vm-public-domain-or-ip>
# DJANGO_CORS_ALLOWED_ORIGINS=https://<vercel-domain>
#
# DATABASE_URL and the Oracle Database connection variables are tracked
# separately in docs/planning/6. oracle-database.md — not required for the
# auth work above, SQLite/psycopg is still the local fallback.
