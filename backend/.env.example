DJANGO_SECRET_KEY=replace-this-in-local-env
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:10050

# Build/version visibility, surfaced by /api/health. Both default to
# "unknown" when unset — an honest "we don't know," never a guessed value.
# Set DJANGO_GIT_SHA to the deployed commit (e.g. $(git rev-parse --short HEAD))
# and DJANGO_ENVIRONMENT to the deploy target (e.g. "production").
# DJANGO_GIT_SHA=
# DJANGO_ENVIRONMENT=

# Authentication abuse controls. Defaults are shown; override only after
# observing legitimate traffic. Each endpoint enforces both windows.
# DJANGO_AUTH_LOGIN_BURST_RATE=5/min
# DJANGO_AUTH_LOGIN_SUSTAINED_RATE=100/day
# DJANGO_AUTH_REGISTER_BURST_RATE=3/min
# DJANGO_AUTH_REGISTER_SUSTAINED_RATE=20/day
# DJANGO_AUTH_GOOGLE_BURST_RATE=10/min
# DJANGO_AUTH_GOOGLE_SUSTAINED_RATE=200/day

# Google Sign-In. Create an OAuth 2.0 Client ID (Web application) in Google
# Cloud Console; restrict "Authorized JavaScript origins" to this app's
# actual origins (e.g. http://localhost:10050 for local dev, the Vercel
# domain for production) — that origin restriction, configured in the
# console, is the primary defense against a forged sign-in from another
# site, not application code.
# GOOGLE_OAUTH_CLIENT_ID=

# Use sqlite locally by default. Set DATABASE_URL for PostgreSQL (production
# runs Neon).
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME

# --- Production (OCI Always Free VM) ---
# DJANGO_DEBUG must be False. A real DJANGO_SECRET_KEY is required or Django
# refuses to start (see config/settings.py). Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# DJANGO_SECRET_KEY=<generated-secret>
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=<your-duckdns-hostname>.duckdns.org
# DJANGO_CORS_ALLOWED_ORIGINS=https://<vercel-domain>
# DJANGO_CSRF_TRUSTED_ORIGINS=https://<your-duckdns-hostname>.duckdns.org
# DJANGO_NUM_PROXIES=1
# DJANGO_CACHE_LOCATION=/home/opc/picking-up/backend/.cache
#
# DATABASE_URL and the Oracle Database connection variables are tracked
# separately in docs/planning/6. oracle-database.md — not required for the
# auth work above, SQLite/psycopg is still the local fallback.

# --- Env file load order ---
# config/settings.py loads .env first, then .env.development as a fallback.
# Values already set (process env or .env) always win. Use .env.development
# for local development; production servers should use a plain .env.
